{
    "files.exclude": {
        "node_modules/": true,
        "dist/": true
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        ".env": ".env.*",
        "apiClient.js": "fcmClient.js",
        "authService.js": "deviceService.js",
        "profileService.js": "entryService.js, bookService.js, headService.js, tagService.js, sourceService.js",
        "triggerService.js": "aggregationService.js",
        "auth.store.js": "device.store.js",
        "profile.store.js": "entry.store.js, book.store.js, head.store.js, tag.store.js, source.store.js",
        "trigger.store.js": "aggregation.store.js",
        ".gitignore": ".gitattributes",
        "tsconfig.json": "tsconfig.*.json, env.d.ts",
        "vite.config.*": "jsconfig*, vitest.config.*, cypress.config.*, playwright.config.*",
        "package.json": "package-lock.json, pnpm*, .yarnrc*, yarn*, .eslint*, eslint*, .oxlint*, oxlint*, .prettier*, prettier*, .editorconfig"
    },
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.organizeImports": "explicit"
    },
    "editor.formatOnType": true,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
}
